                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Login success (200)', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "if (pm.response.code === 200) {",
                      "    const body = pm.response.json();",
                      "    const data = body.data || body;",
                      "    if (data.accessToken) {",
                      "        pm.environment.set('accessToken', data.accessToken);",
                      "        pm.environment.set('activeRole', 'customer');",
                      "        console.log('accessToken (customer) tersimpan otomatis.');",
                      "    }",
                      "    if (data.user && data.user.id) {",
                      "        pm.environment.set('customerId', data.user.id);",
                      "        pm.environment.set('userId', data.user.id);",
                      "    }",
                      "}"
