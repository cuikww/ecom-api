{
  "name": "Auth",
  "description": "Register & Login. Register hanya membuat user dengan role 'customer' (lihat users.CreateUserParam — tidak ada field role). Untuk akun admin, pakai kredensial yang sudah di-seed di DB, lalu login lewat 'Login (Admin)'.",
  "item": [
    {
      "name": "Register User",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": ["{{baseUrl}}"],
          "path": ["users"]
        },
        "description": "Field wajib: fullName, email, password (min 6 karakter)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('User created (200/201)', function () {",
              "    pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "",
              "if ([200, 201].includes(pm.response.code)) {",
              "    const body = pm.response.json();",
              "    const data = body.data || body;",
              "    if (data.id) pm.environment.set('userId', data.id);",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Login (Customer)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users/login",
          "host": ["{{baseUrl}}"],
          "path": ["users", "login"]
        },
        "description": "Login sebagai customer. accessToken otomatis dipakai oleh folder 'Customer'."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login success (200)', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    const body = pm.response.json();",
              "    const data = body.data || body;",
              "    if (data.accessToken) {",
              "        pm.environment.set('accessToken', data.accessToken);",
              "        pm.environment.set('activeRole', 'customer');",
              "        console.log('accessToken (customer) tersimpan otomatis.');",
              "    }",
              "    if (data.user && data.user.id) {",
              "        pm.environment.set('customerId', data.user.id);",
              "        pm.environment.set('userId', data.user.id);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Login (Admin)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users/login",
          "host": ["{{baseUrl}}"],
          "path": ["users", "login"]
        },
        "description": "Login sebagai admin (akun admin harus sudah ada/di-seed di DB). accessToken otomatis dipakai oleh folder 'Admin'."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login admin success (200)', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    const body = pm.response.json();",
              "    const data = body.data || body;",
              "    if (data.accessToken) {",
              "        pm.environment.set('accessToken', data.accessToken);",
              "        pm.environment.set('activeRole', 'admin');",
              "        console.log('accessToken (admin) tersimpan otomatis.');",
              "    }",
              "    if (data.user && data.user.id) {",
              "        pm.environment.set('adminId', data.user.id);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
