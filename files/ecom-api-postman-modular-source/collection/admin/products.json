{
  "name": "Products (Manage)",
  "description": "Sesuai handler.CreateProduct & UpdateProduct. Diasumsikan butuh role admin (silakan sesuaikan folder-level auth kalau ternyata endpoint ini dibuka untuk role lain juga).",
  "item": [
    {
      "name": "Create Product",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_name\": \"Sample Product\",\n  \"price_in_cents\": 150000,\n  \"quantity\": 20\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": ["{{baseUrl}}"],
          "path": ["products"]
        },
        "description": "Field: product_name, price_in_cents, quantity (semua pointer di ProductParams, tapi wajib diisi untuk create)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Product created (200/201)', function () {",
              "    pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "",
              "if ([200, 201].includes(pm.response.code)) {",
              "    const body = pm.response.json();",
              "    const data = body.data || body;",
              "    const id = data.id || data.ID;",
              "    if (id) {",
              "        pm.environment.set('productId', id);",
              "        console.log('productId tersimpan otomatis: ' + id);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Update Product",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_name\": \"Updated Product Name\",\n  \"price_in_cents\": 175000,\n  \"quantity\": 15\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productId}}"]
        },
        "description": "Semua field opsional (pointer), kirim hanya field yang mau diubah — partial update."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Update Product - Not Found",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_name\": \"Ghost Product\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products/999999999",
          "host": ["{{baseUrl}}"],
          "path": ["products", "999999999"]
        },
        "description": "Negative test: update produk yang tidak ada -> ErrProductNotFound -> 404."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Produk tidak ditemukan -> 404', function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Create Product - No Token (harus 401)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_name\": \"Should Fail\",\n  \"price_in_cents\": 1000,\n  \"quantity\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": ["{{baseUrl}}"],
          "path": ["products"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Tanpa token -> 401', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
